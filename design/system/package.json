{
  "name": "tokenpanda-design",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens": "style-dictionary build --config ./style-dictionary.config.js",
    "storybook": "npm run tokens && storybook dev -p 6007 --host 127.0.0.1",
    "build-storybook": "npm run tokens && storybook build -o storybook-static && node scripts/postbuild.mjs storybook-static"
  },
  "devDependencies": {
    "@storybook/html-vite": "9.1.21",
    "mermaid": "12.3.0",
    "storybook": "9.1.21",
    "style-dictionary": "5.7.1",
    "vite": "7.3.7"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.4",
    "@vitest/mocker": "4.1.12"
  }
}
